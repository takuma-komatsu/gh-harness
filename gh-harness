#!/bin/sh

# gh extension install . can invoke this file through a symlink. Find the
# checkout before starting the .NET project so both local and remote installs work.
script_path=$0
case $script_path in
    */*) ;;
    *) script_path=$(command -v "$script_path") || exit 127 ;;
esac
case $script_path in
    /*) ;;
    *) script_path=$PWD/$script_path ;;
esac

while [ -L "$script_path" ]; do
    script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd) || exit 1
    link_target=$(readlink "$script_path") || exit 1
    case $link_target in
        /*) script_path=$link_target ;;
        *) script_path=$script_dir/$link_target ;;
    esac
done

script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd) || exit 1
exec dotnet run --project "$script_dir/src/GhHarness/GhHarness.csproj" --no-launch-profile --verbosity quiet -- "$@"
